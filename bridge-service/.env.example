# Bridge Service Configuration
PORT=3001

# Firebase service account credentials are loaded from serviceAccountKey.json
# Download from Firebase Console > Project Settings > Service Accounts

# For one central Windows bridge, leave both values blank and configure
# station-to-queue mappings in Admin > Printer Settings.
# For separate station-specific bridges, set BRIDGE_STATION and PRINTER_NAME.
# station1 = Firin, station2 = Izgara, station3 = Kasa, station4 = Burger,
# station5 = Tatli. PRINTER_NAME must match a queue installed on this computer.
BRIDGE_STATION=
PRINTER_NAME=
